# Copy this file to .env and fill in the values before running or deploying the app.
# Required for Supabase auth and database access
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional additional keys used by the app
VITE_GEMINI_API_KEY=your-google-gemini-api-key
